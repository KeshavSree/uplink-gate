new file mode 100644
index 0000000..f2b8915
--- /dev/null
+++ b/TestDeploymentsProject/Ref/DictionaryId/DictionaryId.cpp
@@ -0,0 +1,23 @@
+// ======================================================================
+// \title  DictionaryId.cpp
+// \brief  cpp file for DictionaryId component implementation class
+// ======================================================================
+
+#include "Ref/DictionaryId/DictionaryId.hpp"
+
+// Written by the build after the dictionary has been generated. Defines GATE_DICTIONARY_ID.
+#include "Ref/DictionaryId/DictionaryIdValue.hpp"
+
+namespace Ref {
+
+DictionaryId ::DictionaryId(const char* const compName) : DictionaryIdComponentBase(compName) {}
+
+DictionaryId ::~DictionaryId() {}
+
+void DictionaryId ::report() {
+    Fw::String value(GATE_DICTIONARY_ID);
+    Svc::VersionStatus status = Svc::VersionStatus::OK;
+    this->setVersion_out(0, Svc::VersionCfg::VersionEnum::PROJECT_VERSION_00, value, status);
+}
+
+}  // namespace Ref
diff --git a/TestDeploymentsProject/Ref/DictionaryId/DictionaryId.fpp b/TestDeploymentsProject/Ref/DictionaryId/DictionaryId.fpp
new file mode 100644
index 0000000..de9b823
--- /dev/null
+++ b/TestDeploymentsProject/Ref/DictionaryId/DictionaryId.fpp
@@ -0,0 +1,13 @@
+module Ref {
+
+  @ Reports the identity of the dictionary this build was generated with.
+  @ The value is a prefix of the SHA-256 of the dictionary file, so the ground can tell
+  @ which dictionary matches the running build by content instead of by version label.
+  passive component DictionaryId {
+
+    @ Sets a custom version in Svc.Version, which telemeters it
+    output port setVersion: Svc.Version
+
+  }
+
+}
diff --git a/TestDeploymentsProject/Ref/DictionaryId/DictionaryId.hpp b/TestDeploymentsProject/Ref/DictionaryId/DictionaryId.hpp
