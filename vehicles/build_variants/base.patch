+// ======================================================================
+// \title  DictionaryId.hpp
+// \brief  hpp file for DictionaryId component implementation class
+// ======================================================================
+
+#ifndef Ref_DictionaryId_HPP
+#define Ref_DictionaryId_HPP
+
+#include "Ref/DictionaryId/DictionaryIdComponentAc.hpp"
+
+namespace Ref {
+
+class DictionaryId final : public DictionaryIdComponentBase {
+  public:
+    //! Construct object DictionaryId
+    DictionaryId(const char* const compName /*!< The component name*/);
+
+    //! Destroy object DictionaryId
+    ~DictionaryId();
+
+    //! Report the dictionary identity of this build as custom version 0
+    void report();
+};
+
+}  // namespace Ref
+
+#endif
